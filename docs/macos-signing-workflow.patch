diff --git a/.github/workflows/release-desktop.yml b/.github/workflows/release-desktop.yml
index 5eb1ad2d..1dcbf7e3 100644
--- a/.github/workflows/release-desktop.yml
+++ b/.github/workflows/release-desktop.yml
@@ -134,21 +134,130 @@ jobs:
       - name: Build workspace packages
         run: pnpm run build:bootstrap
 
+      # macOS 正式签名 + 公证（需要仓库 Secrets，见 docs/macos-signing.md）：
+      #   MAC_CERT_P12_BASE64 / MAC_CERT_PASSWORD：Developer ID Application 证书（含私钥）
+      #   APPLE_API_KEY_P8_BASE64 / APPLE_API_KEY_ID / APPLE_API_ISSUER：App Store Connect API Key（公证用）
+      # 未配置证书时自动退回 ad-hoc 签名（用户首次打开需要“仍要打开”），不会让构建失败。
+      - name: Import macOS signing certificate
+        id: macsign
+        if: matrix.os == 'mac'
+        shell: bash
+        env:
+          MAC_CERT_P12_BASE64: ${{ secrets.MAC_CERT_P12_BASE64 }}
+          MAC_CERT_PASSWORD: ${{ secrets.MAC_CERT_PASSWORD }}
+          APPLE_API_KEY_P8_BASE64: ${{ secrets.APPLE_API_KEY_P8_BASE64 }}
+          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
+          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
+        run: |
+          set -euo pipefail
+          if [ -z "${MAC_CERT_P12_BASE64:-}" ]; then
+            echo "::warning::未配置 MAC_CERT_P12_BASE64，本次 macOS 包仅 ad-hoc 签名、未公证，用户下载后会被 Gatekeeper 拦截。"
+            echo "enabled=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          KEYCHAIN="$RUNNER_TEMP/mcode-signing.keychain-db"
+          KEYCHAIN_PASSWORD="$(openssl rand -hex 24)"
+          echo "$MAC_CERT_P12_BASE64" | base64 --decode > "$RUNNER_TEMP/cert.p12"
+          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
+          security set-keychain-settings -lut 21600 "$KEYCHAIN"
+          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
+          security import "$RUNNER_TEMP/cert.p12" -k "$KEYCHAIN" -P "$MAC_CERT_PASSWORD" -f pkcs12 \
+            -T /usr/bin/codesign -T /usr/bin/productsign -T /usr/bin/security
+          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN" > /dev/null
+          security list-keychains -d user -s "$KEYCHAIN" $(security list-keychains -d user | tr -d '"')
+          rm -f "$RUNNER_TEMP/cert.p12"
+          IDENTITY="$(security find-identity -v -p codesigning "$KEYCHAIN" | grep -o '"Developer ID Application: [^"]*"' | head -1 | tr -d '"')"
+          if [ -z "$IDENTITY" ]; then
+            echo "::error::证书里没有找到 Developer ID Application 身份（是不是导出成了 Apple Distribution / Apple Development？）"
+            security find-identity -v -p codesigning "$KEYCHAIN"
+            exit 1
+          fi
+          echo "Signing identity: $IDENTITY"
+          {
+            echo "MCODE_ENABLE_MAC_SIGN=1"
+            echo "APPLE_SIGNING_IDENTITY=$IDENTITY"
+            echo "CSC_KEYCHAIN=$KEYCHAIN"
+          } >> "$GITHUB_ENV"
+          if [ -n "${APPLE_API_KEY_P8_BASE64:-}" ] && [ -n "${APPLE_API_KEY_ID:-}" ] && [ -n "${APPLE_API_ISSUER:-}" ]; then
+            API_KEY_PATH="$RUNNER_TEMP/AuthKey_${APPLE_API_KEY_ID}.p8"
+            echo "$APPLE_API_KEY_P8_BASE64" | base64 --decode > "$API_KEY_PATH"
+            chmod 600 "$API_KEY_PATH"
+            {
+              echo "APPLE_API_KEY=$API_KEY_PATH"
+              echo "APPLE_API_KEY_ID=$APPLE_API_KEY_ID"
+              echo "APPLE_API_ISSUER=$APPLE_API_ISSUER"
+            } >> "$GITHUB_ENV"
+            echo "notarize=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "::warning::未配置 App Store Connect API Key，本次只签名不公证。"
+            echo "notarize=false" >> "$GITHUB_OUTPUT"
+          fi
+          echo "enabled=true" >> "$GITHUB_OUTPUT"
+
       - name: Bundle desktop installer
         run: pnpm bundle:desktop -- --os ${{ matrix.os }} --arch ${{ matrix.arch }} --skip-prepare --skip-build
 
-      # 未签名发布的 .app 必须是完整、一致的 ad-hoc 签名，否则下载后会被 Gatekeeper 判为“已损坏”。
+      # .app 已在 electron-builder 内公证 + staple；dmg 是新文件，需要再单独公证并 staple，
+      # 这样用户离线双击 dmg 也能通过 Gatekeeper。
+      - name: Notarize and staple macOS dmg
+        if: matrix.os == 'mac' && steps.macsign.outputs.notarize == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          dmgs=(packages/desktop/dist/*.dmg)
+          [ ${#dmgs[@]} -gt 0 ] || { echo "no dmg found" >&2; exit 1; }
+          for dmg in "${dmgs[@]}"; do
+            echo "Notarizing $dmg"
+            xcrun notarytool submit "$dmg" \
+              --key "$APPLE_API_KEY" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER" \
+              --wait --timeout 60m --output-format json | tee "$RUNNER_TEMP/notary.json"
+            status="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["status"])' "$RUNNER_TEMP/notary.json")"
+            if [ "$status" != "Accepted" ]; then
+              id="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["id"])' "$RUNNER_TEMP/notary.json")"
+              xcrun notarytool log "$id" --key "$APPLE_API_KEY" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER" || true
+              echo "::error::dmg 公证失败：$status"
+              exit 1
+            fi
+            xcrun stapler staple "$dmg"
+            xcrun stapler validate "$dmg"
+          done
+          # electron-builder 的 blockmap 基于 staple 前的 dmg 计算，staple 后需重新生成，避免增量更新校验失败。
+          # （mac 自动更新走 zip，dmg.blockmap 仅作参考，这里直接删除过期文件。）
+          rm -f packages/desktop/dist/*.dmg.blockmap
+
+      # .app 签名必须完整一致，否则下载后会被 Gatekeeper 判为“已损坏”。
+      # 已公证时额外用 spctl 模拟用户下载后的 Gatekeeper 判定，不通过直接失败，杜绝把坏包发出去。
       - name: Verify macOS app signature
         if: matrix.os == 'mac'
         shell: bash
+        env:
+          MAC_NOTARIZED: ${{ steps.macsign.outputs.notarize }}
         run: |
+          set -euo pipefail
           shopt -s nullglob
           apps=(packages/desktop/dist/mac*/*.app)
           [ ${#apps[@]} -gt 0 ] || { echo "no .app found" >&2; ls -R packages/desktop/dist | head -50; exit 1; }
           for app in "${apps[@]}"; do
             codesign --verify --deep --strict --verbose=2 "$app"
-            codesign -dv --verbose=2 "$app" 2>&1 | grep -E "Identifier|Signature|Sealed Resources"
+            codesign -dv --verbose=2 "$app" 2>&1 | grep -E "Identifier|Authority|TeamIdentifier|Signature|Sealed Resources|flags"
+            if [ "${MAC_NOTARIZED:-}" = "true" ]; then
+              xcrun stapler validate "$app"
+              spctl -a -vvv -t exec "$app"
+            fi
           done
+          if [ "${MAC_NOTARIZED:-}" = "true" ]; then
+            for dmg in packages/desktop/dist/*.dmg; do
+              spctl -a -vvv -t open --context context:primary-signature "$dmg"
+            done
+          fi
+
+      - name: Cleanup macOS signing keychain
+        if: always() && matrix.os == 'mac' && steps.macsign.outputs.enabled == 'true'
+        shell: bash
+        run: |
+          security delete-keychain "$RUNNER_TEMP/mcode-signing.keychain-db" || true
+          rm -f "$RUNNER_TEMP"/AuthKey_*.p8
 
       - name: Collect artifacts
         shell: bash
