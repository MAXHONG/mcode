# Mcode Web service settings — copy to ~/.config/mcode/web.env and `chmod 600` it.

# Listen address. 127.0.0.1 = this machine only (use with an SSH tunnel / reverse proxy).
# 0.0.0.0 = reachable from the LAN (only on a trusted network).
MCODE_WEB_HOST=0.0.0.0
MCODE_WEB_PORT=3030

# Project directory the Web UI opens by default.
MCODE_WEB_WORKSPACE=/home/youruser/projects/myapp

# Fixed access token so the URL stays the same across restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then open  http://<server-ip>:3030/?token=<token>  once; the browser keeps it in a cookie.
MCODE_WEB_TOKEN=replace-with-a-long-random-token

# Optional: extra browser origins allowed to open the WebSocket (comma separated),
# e.g. the public URL of an HTTPS reverse proxy in front of Mcode.
# MCODE_SERVER_ALLOWED_ORIGINS=https://mcode.example.com

# 手机扫码远程控制（经 zcode.z.ai relay）。设为 0 关闭。
# MCODE_WEB_REMOTE_CONTROL=1
