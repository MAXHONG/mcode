{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mcode/browser-use-plugin",
  "version": "0.5.1",
  "private": true,
  "description": "作为官方 Mcode 内置插件发布的 Browser Use skill 与 client runtime；node_repl MCP server 由 @mcode/node-repl-host 提供。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mcp/server.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "lint": "oxlint src --no-ignore"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@mcode/contracts": "workspace:*",
    "@mcode/core": "workspace:*",
    "@mcode/node-repl-host": "workspace:*",
    "@mcode/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "@mcode/adapters": "workspace:*",
    "@mcode/bootstrap": "workspace:*",
    "esbuild": "^0.25.0",
    "playwright-core": "1.59.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
